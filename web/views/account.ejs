<!doctype html><html><head><title>Vitalix — Account</title>
<%- include('partials/style') %>
</head><body>
<div class="wrap-narrow">
<h1>Vitalix</h1><h2>Account</h2>
<p class="sub"><%= email %> · <a href="/dashboard">Back to dashboard</a></p>

<h3>Export your data</h3>
<p>Everything stored for your account: daily values, readings, exercises, journal and AI text. Limited to 3 exports per hour.</p>
<p><a href="/account/export.json">Download all data (JSON)</a></p>
<p><a href="/account/export-days.csv">Download daily values (CSV)</a></p>

<h3>Delete account</h3>
<p>Permanently deletes your account and all data above. This cannot be undone.</p>
<% if (error) { %><p class="err"><%= error %></p><% } %>
<form method="post" action="/account/delete">
  <input name="email" type="email" placeholder="Type your email (<%= email %>) to confirm" autocomplete="off" required>
  <input name="password" type="password" placeholder="Password" autocomplete="current-password" required>
  <button type="submit">Delete permanently</button>
</form>
</div>
</body></html>
