<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vitalix — Daily Review</title>
<link rel="stylesheet" href="/style.css">
<style>
.review-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px}
.review-header h2{margin:0;font-size:22px}
.date-form{display:flex;gap:8px}
.review-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:16px 0}
.metric-box{background:var(--card);border:1px solid var(--line);padding:12px 16px;border-radius:8px}
.metric-title{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.metric-val{font-size:20px;font-weight:650;letter-spacing:-0.02em}
.metric-sub{font-size:12px;color:var(--muted);margin-top:4px}
.delta-tag{font-size:12px;margin-left:6px;padding:2px 6px;border-radius:4px}
.delta-pos{background:rgba(52,211,153,.15);color:var(--success)}
.delta-neg{background:rgba(185,28,28,.10);color:var(--error)}
.ai-card{margin-top:24px}
.ai-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px}
.ai-header-left{display:flex;align-items:center;gap:8px}
.ai-badge{background:var(--teal);color:#fff;font-size:12px;font-weight:600;padding:4px 8px;border-radius:4px}
.ai-header h3{margin:0}
.ai-content{line-height:1.6;white-space:pre-wrap}
.disclaimer{font-size:11px;color:var(--muted);margin-top:12px;font-style:italic}
</style>
</head>
<body>
<div class="wrap">

<div class="topbar">
  <div>
    <h1>Vitalix</h1>
    <p class="sub"><%= email || "Signed in" %></p>
  </div>
  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/daily-review">Daily Review</a>
    <% if (userRole === "admin") { %><a href="/admin">Admin</a><% } %>
    <form method="post" action="/logout"><button type="submit">Log out</button></form>
  </nav>
</div>

<div class="review-header">
  <h2>Daily Review</h2>
  <form method="GET" action="/daily-review" class="date-form">
    <input type="date" name="day" value="<%= date %>">
    <button type="submit">View Date</button>
  </form>
</div>

<div class="card">
  <h2 style="margin-top:0">Summary & Trends (<%= date %>)</h2>
  <div class="review-grid">
    <div class="metric-box">
      <div class="metric-title">Steps</div>
      <div class="metric-val">
        <%= dayData.steps || '—' %>
        <% if (deltas.steps) { %>
          <span class="delta-tag <%= deltas.steps >= 0 ? 'delta-pos' : 'delta-neg' %>">
            <%= deltas.steps >= 0 ? '+' : '' %><%= deltas.steps %> vs yesterday
          </span>
        <% } %>
      </div>
      <div class="metric-sub">7d avg: <%= baseline7d.steps || '—' %></div>
    </div>

    <div class="metric-box">
      <div class="metric-title">Active Calories</div>
      <div class="metric-val">
        <%= dayData.active_calories ? Math.round(dayData.active_calories) + ' kcal' : '—' %>
      </div>
      <div class="metric-sub">7d avg: <%= baseline7d.active_calories ? Math.round(baseline7d.active_calories) + ' kcal' : '—' %></div>
    </div>

    <div class="metric-box">
      <div class="metric-title">Sleep Duration</div>
      <div class="metric-val">
        <%= dayData.sleep_duration_minutes ? Math.round(dayData.sleep_duration_minutes / 60 * 10) / 10 + ' hrs' : '—' %>
      </div>
      <div class="metric-sub">7d avg: <%= baseline7d.sleep_duration_minutes ? Math.round(baseline7d.sleep_duration_minutes / 60 * 10) / 10 + ' hrs' : '—' %></div>
    </div>

    <div class="metric-box">
      <div class="metric-title">Resting HR</div>
      <div class="metric-val">
        <%= dayData.resting_heart_rate ? Math.round(dayData.resting_heart_rate) + ' bpm' : '—' %>
        <% if (deltas.resting_heart_rate) { %>
          <span class="delta-tag <%= deltas.resting_heart_rate <= 0 ? 'delta-pos' : 'delta-neg' %>">
            <%= deltas.resting_heart_rate >= 0 ? '+' : '' %><%= Math.round(deltas.resting_heart_rate) %>
          </span>
        <% } %>
      </div>
      <div class="metric-sub">7d avg: <%= baseline7d.resting_heart_rate ? Math.round(baseline7d.resting_heart_rate) + ' bpm' : '—' %></div>
    </div>
  </div>
</div>

<div class="card ai-card">
  <div class="ai-header">
    <div class="ai-header-left">
      <span class="ai-badge">AI INSIGHTS</span>
      <h3>Health & Habit Recommendations</h3>
    </div>
    <button id="btn-generate" onclick="generateRecommendation()">Generate Insights</button>
  </div>

  <div id="ai-content" class="ai-content">
    <%= recommendation ? recommendation.recommendation_text : "Click 'Generate Insights' to receive personalized health and habit coaching based on your metrics." %>
  </div>

  <div class="disclaimer">
    Vitalix AI Insights are generated automatically for motivational fitness & habit coaching. They do not constitute medical advice.
  </div>
</div>

<script>
async function generateRecommendation() {
  var btn = document.getElementById('btn-generate');
  var content = document.getElementById('ai-content');
  btn.disabled = true;
  btn.innerText = 'Generating...';
  try {
    var res = await fetch('/api/ai/recommendations/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ day: '<%= date %>' })
    });
    var data = await res.json();
    if (data.text) {
      content.innerText = data.text;
    } else if (data.error) {
      content.innerText = data.error;
    } else {
      content.innerText = 'Unable to generate recommendation at this time.';
    }
  } catch (err) {
    content.innerText = 'Error connecting to AI service.';
  } finally {
    btn.disabled = false;
    btn.innerText = 'Generate Insights';
  }
}
</script>

<footer class="build-footer">
  Vitalix · Daily Review
</footer>
</div>
</body>
</html>
