# App
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:3000

# Database (DATABASE_URL is constructed from these in docker-compose)
POSTGRES_USER=vitalix
POSTGRES_PASSWORD=vitalix
POSTGRES_DB=vitalix
DB_PORT=5432
# Optional SMTP; if unset, reset/invite links are logged to the server console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=secret
# MAIL_FROM=Vitalix <no-reply@yourdomain>

# Optional Zealot; if unset, invite emails omit the app download link
# ZEALOT_ENDPOINT=https://zealot.example.com
# ZEALOT_TOKEN=your-zealot-api-token
# ZEALOT_CHANNEL_KEY=your-production-channel-key

# Optional AI Recommendations (defaults to local Ollama)
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3:latest
# AI_API_KEY=your-openai-or-cloud-api-key
