default_platform(:android)

VERSION_FILE = File.expand_path("../version.properties", Dir.pwd)
VERSION_FILE_REL = "version.properties"

def read_versions(flavor)
  props = {}
  File.readlines(VERSION_FILE).each do |line|
    key, value = line.strip.split("=", 2)
    props[key] = value if key && value
  end
  {
    code: props["#{flavor}.versionCode"].to_i,
    name: props["#{flavor}.versionName"]
  }
end

def bump_version(flavor, type: :patch)
  lines = File.readlines(VERSION_FILE)
  v = read_versions(flavor)
  new_code = v[:code] + 1

  parts = v[:name].split(".").map(&:to_i)
  case type
  when :major
    parts = [parts[0] + 1, 0, 0]
  when :minor
    parts = [parts[0], parts[1] + 1, 0]
  when :patch
    parts = [parts[0], parts[1], parts[2] + 1]
  end
  new_name = parts.join(".")

  updated = lines.map do |line|
    if line.start_with?("#{flavor}.versionCode=")
      "#{flavor}.versionCode=#{new_code}\n"
    elsif line.start_with?("#{flavor}.versionName=")
      "#{flavor}.versionName=#{new_name}\n"
    else
      line
    end
  end
  File.write(VERSION_FILE, updated.join)

  UI.success "#{flavor}: #{v[:name]} (#{v[:code]}) → #{new_name} (#{new_code})"
  { code: new_code, name: new_name }
end

ANDROID_DIR = File.expand_path("..", __dir__)

# Release notes for Zealot (shown on the in-app update screen): subjects of
# commits that touched android/ since this flavor's previous release (its "bump
# <flavor> to" commit). Web/docs commits and release tooling (fastlane, Gemfile,
# version.properties) stay out. Runs before this release's bump is committed.
def mobile_changelog(flavor)
  git = ["git", "-C", ANDROID_DIR]
  last = IO.popen(git + ["log", "-1", "--format=%H", "--grep=^bump #{flavor} to"], &:read).strip
  range = last.empty? ? "HEAD" : "#{last}..HEAD"
  notes = IO.popen(git + ["log", "--no-merges", "--format=- %s", range, "--", ".", ":!version.properties", ":!fastlane", ":!Gemfile", ":!Gemfile.lock"], &:read).strip
  notes.empty? ? "- Maintenance build" : notes
end

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new Beta Build to Zealot. Bumps the beta version in version.properties (versionCode +1, versionName per bump:major|minor|patch, default patch), builds assembleBetaRelease, uploads to Zealot, then commits the version bump. Example: fastlane android beta bump:minor"
  lane :beta do |options|
    bump_type = (options[:bump] || "patch").to_sym
    v = bump_version("beta", type: bump_type)

    gradle(task: "clean assembleBetaRelease")

    zealot(
      endpoint: ENV["ZEALOT_ENDPOINT"],
      token: ENV["ZEALOT_TOKEN"],
      channel_key: ENV["ZEALOT_BETA_CHANNEL_KEY"],
      changelog: mobile_changelog("beta"),
      release_type: "beta",
      branch: git_branch,
      git_commit: last_git_commit[:commit_hash]
    )

    git_commit(
      path: VERSION_FILE_REL,
      message: "bump beta to #{v[:name]} (#{v[:code]})"
    )
  end

  desc "Deploy a new production version to Zealot. Bumps the production version in version.properties (versionCode +1, versionName per bump:major|minor|patch, default patch), builds assembleProductionRelease, uploads to Zealot, then commits the version bump. Example: fastlane android production bump:major"
  lane :production do |options|
    bump_type = (options[:bump] || "patch").to_sym
    v = bump_version("production", type: bump_type)

    gradle(task: "clean assembleProductionRelease")

    zealot(
      endpoint: ENV["ZEALOT_ENDPOINT"],
      token: ENV["ZEALOT_TOKEN"],
      channel_key: ENV["ZEALOT_PROD_CHANNEL_KEY"],
      changelog: mobile_changelog("production"),
      release_type: "release",
      branch: git_branch,
      git_commit: last_git_commit[:commit_hash]
    )

    git_commit(
      path: VERSION_FILE_REL,
      message: "bump production to #{v[:name]} (#{v[:code]})"
    )
  end
end
