<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Permits cleartext HTTP so a device can reach a receiver on
  the developer's machine — over an adb reverse tunnel (localhost), an emulator
  host alias (10.0.2.2), or the LAN address, which is the only one that survives
  the screen sleeping. Release builds keep the platform default: HTTPS only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
