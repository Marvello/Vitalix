<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Vitalix" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vital_teal</item>
        <item name="materialButtonStyle">@style/Widget.Vitalix.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Vitalix.Button.OutlinedButton</item>
        <item name="borderlessButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Vitalix.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Vitalix.AlertDialog</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pulse_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/bg_app</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline_subtle</item>
        <item name="colorOutlineVariant">@color/outline_subtle</item>
    </style>

    <!-- Filled buttons use button_primary; accents (progress, switches) keep colorPrimary. -->
    <style name="Widget.Vitalix.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
    </style>

    <!-- Outlined/text buttons: teal text on light surfaces needs the darker vital_teal_text. -->
    <style name="Widget.Vitalix.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/button_text_teal</item>
        <item name="iconTint">@color/button_text_teal</item>
        <item name="rippleColor">@color/button_ripple_teal</item>
        <item name="strokeColor">@color/button_outline_teal</item>
    </style>

    <style name="Widget.Vitalix.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/button_text_teal</item>
        <item name="iconTint">@color/button_text_teal</item>
        <item name="rippleColor">@color/button_ripple_teal</item>
    </style>

    <!-- Dialog buttons: teal text needs the darker vital_teal_text (night-aware) on dialog surfaces. -->
    <style name="ThemeOverlay.Vitalix.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
    </style>

    <style name="ThemeOverlay.Vitalix.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Vitalix.Button.TextButton</item>
    </style>

    <style name="Theme.Vitalix" parent="Base.Theme.Vitalix" />
</resources>