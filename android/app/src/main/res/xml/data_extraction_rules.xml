<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: Keystore-wrapped SecurePrefs stores can't be decrypted
     after a restore or device transfer, so neither path carries them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vitalix_auth.xml"/>
        <exclude domain="sharedpref" path="vitalix_auth__keyset_prefs.xml"/>
        <exclude domain="sharedpref" path="vitalix_secure.xml"/>
        <exclude domain="sharedpref" path="vitalix_secure__keyset_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vitalix_auth.xml"/>
        <exclude domain="sharedpref" path="vitalix_auth__keyset_prefs.xml"/>
        <exclude domain="sharedpref" path="vitalix_secure.xml"/>
        <exclude domain="sharedpref" path="vitalix_secure__keyset_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
